VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Public OAuth client id for Sign in with ArjenHub.
# Register redirect URI exactly (trailing slash): https://YOUR_DOMAIN/
# Production example: https://arjenhub-web.vercel.app/
VITE_ARJENHUB_CLIENT_ID=

# Only this email can open /panel/developer and manage OAuth clients.
# Must match Edge Function secret DEVELOPER_EMAIL (default below).
VITE_DEVELOPER_EMAIL=newlifearjen@gmail.com
